{
	"manifest_version": 2,
	"name": "YT SuperTool",
	"version": "1.0.0",
	"description": "All-in-One YouTube enhancer.",
	"permissions": ["storage", "*://*.youtube.com/*", "https://returnyoutubedislikeapi.com/*", "https://ssyoutube.com/*"],
	"optional_permissions": [],
	"background": { "scripts": ["background/background.js"], "persistent": true },
	"browser_action": { "default_title": "YT SuperTool", "default_popup": "popup/popup.html" },
	"content_scripts": [{
		"matches": ["*://*.youtube.com/*"],
		"js": ["content/features/dislike.js", "content/features/no-shorts.js", "content/features/clean-homepage.js", "content/features/nonstop.js", "content/features/speed.js", "content/features/downloader.js", "content/features/pip.js", "content/features/screenshot.js", "content/observer.js", "content/main.js"],
		"run_at": "document_idle"
	}],
	"icons": { "16": "assets/icons/icon16.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png" }
}
